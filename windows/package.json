{
  "name": "thongs-local",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, local-first desktop task manager for Windows",
  "author": "Thongs project contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.thongs.desktop",
    "productName": "Thongs Local",
    "copyright": "Copyright (c) 2026 Thongs project contributors",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE-BINARY.txt",
        "to": "LICENSE-BINARY.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Thongs-Local-${version}-Windows-${arch}.${ext}"
    }
  }
}
